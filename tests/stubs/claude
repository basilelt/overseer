#!/bin/sh
[ "${1:-}" = "--version" ] && { echo "0.0.0 (stub)"; exit 0; }
sid=${SB_STUB_SESSION:-}
prev=
for a in "$@"; do
  [ "$prev" = "--resume" ] && sid=$a
  [ "$prev" = "--session-id" ] && sid=$a
  prev=$a
done
dir=${CLAUDE_CONFIG_DIR:?}
mkdir -p "$dir/sessions"
echo "$$ $*" >> "${SB_STUB_LOG:?}"
printf '%s\n' "$PATH" > "$SB_STUB_LOG.path"
# procStart is /proc's start tick; empty elsewhere, where the daemon compares startedAt instead.
start=$(cut -d' ' -f22 /proc/$$/stat 2>/dev/null || true)
started=$(date +%s)000
proj="$dir/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
mkdir -p "$proj"
printf '{"type":"user","sessionId":"%s","cwd":"%s","timestamp":"%s"}\n' "$sid" "$PWD" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$proj/$sid.jsonl"
status() {
  now=$(date +%s)000
  printf '{"pid":%s,"sessionId":"%s","cwd":"%s","startedAt":%s,"procStart":"%s","status":"%s","updatedAt":%s,"statusUpdatedAt":%s,"kind":"interactive"}\n' \
    $$ "$sid" "$PWD" "$started" "$start" "$1" "$now" "$now" > "$dir/sessions/$$.json"
}
hook() {
  printf '{"session_id":"%s","cwd":"%s","hook_event_name":"%s","prompt":"PRIVATE"}' "$sid" "$PWD" "$1" |
    "${SB_BIN:?}" hook claude "$1" $$
}
tool=
cleanup() { [ -n "$tool" ] && kill "$tool" 2>/dev/null; rm -f "$dir/sessions/$$.json"; exit 0; }
trap cleanup TERM HUP
[ -n "${SB_STUB_BOOT:-}" ] && sleep "$SB_STUB_BOOT"
if [ -e "$SB_STUB_LOG.trust" ]; then
  printf '%s\n' ' Accessing workspace:' '' " $PWD" '' ' Quick safety check: Is this a project you created or one you trust?' '' ' ❯ No, exit' '   Yes, I trust this folder' '' ' Enter to confirm · Esc to cancel'
  IFS= read -r answer || exit 0
  [ "$answer" = "trust" ] || exit 0
fi
status idle
hook SessionStart
prompt() { printf '%s\n' "────────────────────────────────────────"; printf '❯ '; }
prompt
while IFS= read -r line; do
  case $line in
    busy) status busy; hook UserPromptSubmit ;;
    done) status idle; hook Stop ;;
    tool) sh -c ': shell-snapshots/snapshot-sh-1.sh; sleep 60; :' & tool=$! ;;
    untool) kill "$tool"; tool= ;;
    mcp) set -m; sh -c ': mcp-server; sleep 300; :' & echo $! > "$SB_STUB_LOG.mcp"; set +m ;;
    mcpstubborn) set -m; sh -c ': mcp-server; trap "" TERM; while :; do sleep 1; done' & echo $! > "$SB_STUB_LOG.mcpstubborn"; set +m ;;
    ask) hook PermissionRequest ;;
    multiask)
      printf '%s\n' '←  ☐ Fruits  ✔ Submit  →' '' 'Which fruits do you like?' '' '❯ 1. [ ] Apple' '         red' '  2. [ ] Banana' '         yellow' \
        '  3. [ ] Type something' '     Submit' '────────────────────────' '  4. Chat about this' '' 'Enter to select · ↑/↓ to navigate · Esc to cancel'
      hook PermissionRequest
      continue ;;
    approved) hook PostToolUse ;;
    sub) hook SubagentStart ;;
    unsub) hook SubagentStop ;;
    task) hook TaskCreated ;;
    untask) hook TaskCompleted ;;
    *) printf 'got: %s\n' "$line" ;;
  esac
  prompt
done
cleanup
