#!/bin/sh
name=$(basename "$0")
[ "${1:-}" = "--version" ] && { echo "$name 0.0.0 (stub)"; exit 0; }
echo "$$ $name $*" >> "${SB_STUB_LOG:?}"
printf '%s ready\r\n> ' "$name"
while IFS= read -r l; do
  [ "$l" = "exit" ] && exit 0
  [ "$l" = "mouse" ] && { printf '\033[?1049h\033[?1000h\033[?1002h\033[?1006h\r\n'; continue; }
  [ "$l" = "nomouse" ] && { printf '\033[?1006l\033[?1002l\033[?1000l\033[?1049l'; continue; }
  printf 'got: %s\r\n> ' "$l"
done
