{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overseer",
  "version": "0.34.1",
  "identifier": "io.github.basilelt.overseer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Overseer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; frame-src blob:; object-src blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server/": "server/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCRkYxQUFDNTAyREYyOTcKUldTWDhpMVFyQnIvTzNxSVNtdURZS20xcXo4SkdEdGlSUmNheDZua3J4aHZZVGxES3ZtNHQzTHoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
